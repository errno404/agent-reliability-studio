# Copy to .env (never commit .env). Everything below is OPTIONAL: the demo needs no keys.

# --- core ---------------------------------------------------------------
DATABASE_URL=sqlite:///./ars.db            # or postgresql+psycopg://user:pass@host:5432/ars
DEMO_MODE=true                             # true = read-only public demo (all mutations return 403)
ENVIRONMENT=development                    # production hides error details from API responses
ADMIN_TOKEN=                               # required (X-Admin-Token) for mutations when DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000
FORWARDED_ALLOW_IPS=127.0.0.1              # peers allowed to set X-Forwarded-For (your web tier only; never "*" on a public API)
ENABLE_CODING_EXECUTION=false              # coding agents run local scripts; keep off on any public host
STALE_JOB_SECONDS=120
LOG_LEVEL=INFO

# --- web ----------------------------------------------------------------
API_URL=http://127.0.0.1:8000              # read at runtime by the web app's /api proxy
TRUSTED_PROXY_HOPS=0                       # trusted edge proxies in front of the web app (0 = ignore client X-Forwarded-For)

# --- optional live integrations (never required) -------------------------
ANTHROPIC_API_KEY=                         # LiteLLM adapter / live judge (litellm picks up provider keys)
OPENAI_API_KEY=
OTLP_ENDPOINT=                             # e.g. http://localhost:6006/v1/traces (Phoenix mirror)
